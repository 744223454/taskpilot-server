TASKPILOT_NAME=taskpilot-api
TASKPILOT_HOST=0.0.0.0
TASKPILOT_PORT=8888
TASKPILOT_MODE=release
TASKPILOT_HTTP_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
POSTGRES_PASSWORD=<replace-with-strong-password>
TASKPILOT_DATABASE_DSN=postgres://taskpilot:<replace-with-strong-password>@postgres:5432/taskpilot?sslmode=disable
TASKPILOT_REDIS_HOST=redis:6379
TASKPILOT_REDIS_PASS=<replace-if-needed>
TASKPILOT_REDIS_TYPE=node
TASKPILOT_AUTH_ACCESS_SECRET=<replace-with-long-random-secret>
TASKPILOT_AUTH_ACCESS_EXPIRE=900
TASKPILOT_AUTH_REFRESH_EXPIRE=2592000
TASKPILOT_AUTH_COOKIE_SECURE=true
TASKPILOT_AUTH_LOGIN_RATE_LIMIT=10
TASKPILOT_AUTH_LOGIN_RATE_WINDOW=300
TASKPILOT_AUTH_REGISTER_RATE_LIMIT=20
TASKPILOT_AUTH_REGISTER_RATE_WINDOW=3600
TASKPILOT_UPLOAD_ROOT=/app/uploads
TASKPILOT_UPLOAD_MAX_FILE_BYTES=10485760
TASKPILOT_UPLOAD_MAX_PAGES=50
TASKPILOT_UPLOAD_MAX_TEXT_CHARS=50000
TASKPILOT_UPLOAD_MIN_EFFECTIVE_CHARS=20
TASKPILOT_UPLOAD_EXTRACT_TIMEOUT=15
TASKPILOT_UPLOAD_MAX_CONCURRENT_EXTRACTIONS=2
TASKPILOT_UPLOAD_SLOT_WAIT_TIMEOUT=3
TASKPILOT_UPLOAD_TEMP_GRACE=3600
TASKPILOT_UPLOAD_ORPHAN_GRACE=86400
TASKPILOT_UPLOAD_CLEANUP_INTERVAL=86400
